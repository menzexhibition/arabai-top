# Copy to .env on the deployment host and replace every CHANGE_ME value.

PORT=3000
FRONTEND_BASE_URL=https://api.arabai.top
TZ=Asia/Shanghai
NODE_NAME=arabai-api-gateway-1
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SESSION_SECRET

POSTGRES_USER=arabai_new_api
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=new_api
SQL_DSN=postgresql://arabai_new_api:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/new_api

REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_CONN_STRING=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379

# Optional: generate an initial token only if you need bootstrap automation.
# GENERATE_DEFAULT_TOKEN=CHANGE_ME_OPTIONAL_BOOTSTRAP_TOKEN
