{
  "functions": {
    "api/*.js": {
      "runtime": "@vercel/node"
    }
  },
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app-framework/prototype/public/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app-framework/prototype/public/:path*"
    }
  ]
}
