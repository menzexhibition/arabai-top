# Public site
ARABAI_PUBLIC_URL=https://arabai.top
ARABAI_APP_URL=https://app.arabai.top
ARABAI_API_URL=https://api.arabai.top
ARABAI_DEFAULT_LANGUAGE=ar

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Auth
AUTH_PROVIDER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_keep_server_side_only

# Payments
PAYMENT_PROVIDER=none
PAYMENT_MODE=test
AIRWALLEX_CLIENT_ID=your_airwallex_client_id
AIRWALLEX_API_KEY=your_airwallex_api_key
AIRWALLEX_WEBHOOK_SECRET=your_airwallex_webhook_secret
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Regional payment provider, if needed later
REGIONAL_PAYMENT_PROVIDER=moyasar_or_paytabs_or_tap
REGIONAL_PAYMENT_SECRET=your_regional_payment_secret

# AI providers
AI_GATEWAY_PROVIDER=new-api
USE_REAL_AI_GATEWAY=false
AI_GATEWAY_BASE_URL=https://api.mytokenland.com
AI_GATEWAY_API_KEY=your_server_side_ai_gateway_key
AI_GATEWAY_TEXT_MODEL=claude-sonnet-4-6
AI_GATEWAY_IMAGE_MODEL=gpt-image-2
AI_GATEWAY_TIMEOUT_MS=60000

# Model routing
# Keep provider keys server-side. Normal users should see task names, not raw model IDs.
AI_MODEL_FREE_CHAT=doubao-seed-2.0-lite
AI_MODEL_DEFAULT_CHAT=claude-sonnet-4-6
AI_MODEL_PREMIUM_CHAT=gpt-5.4-mini
AI_MODEL_TOP_CHAT=gpt-5.4
AI_MODEL_REASONING=deepseek-v4-flash
AI_MODEL_STRONG_REASONING=deepseek-v4-pro
AI_MODEL_CODING=gpt-5.3-codex
AI_MODEL_IMAGE=gpt-image-2

OPENROUTER_API_KEY=your_openrouter_key
SILICONFLOW_API_KEY=your_siliconflow_key
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key
GOOGLE_AI_API_KEY=your_google_ai_key

# Storage
STORAGE_BUCKET=your_storage_bucket_name
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key

# Credits
SIGNUP_REWARD_CREDITS=20
DAILY_LOGIN_MIN_CREDITS=1
DAILY_LOGIN_MAX_CREDITS=2
DAILY_LOGIN_WEEKLY_CAP=10
REFERRAL_REGISTER_CREDITS=20
REFERRAL_FIRST_PAID_CREDITS=20
PROVIDER_COST_TARGET_RATIO=0.5
ENABLE_REAL_RECHARGE=false
ENABLE_AI_REDEMPTION=false

# Limits
FREE_CREDIT_DAILY_SPEND_CAP=20
PAID_CREDIT_DAILY_SPEND_CAP=300
MEDIA_TASK_CONCURRENCY=2
TEXT_TASK_CONCURRENCY=20

# Analytics
ANALYTICS_PROVIDER=google_analytics_or_posthog
ANALYTICS_WRITE_KEY=your_analytics_write_key
